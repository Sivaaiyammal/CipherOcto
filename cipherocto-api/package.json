    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^11.3.0",
    "mongoose": "^9.11.2",
    "openapi-types": "^12.1.3",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "mongodb-memory-server": "^11.3.0",
