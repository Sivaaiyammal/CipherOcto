# Copy to .env — never commit .env.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# MongoDB connection string (Atlas, Docker Compose, or `npm run dev:db`).
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:   mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
# CipherOcto's own database; kept separate from any other project on the same cluster.
MONGODB_DB=cipherocto

# Browser origins allowed to call the API with cookies (Vite dev + preview by default).
WEB_ORIGINS=http://localhost:5173,http://localhost:4173

# First admin, created on boot if missing. Use a long, unique password.
SEED_ADMIN_EMAIL=admin@cipherocto.local
SEED_ADMIN_PASSWORD=change-me-before-sharing
SEED_ADMIN_NAME=Workspace Admin

# One-click demo accounts (one per role). Dev only — the server refuses to start
# with this on when NODE_ENV=production.
DEMO_LOGIN=true

# OpenAPI docs at /api/v1/docs (on by default outside production).
# API_DOCS=true

# Production only:
# TRUST_PROXY=true          # behind a proxy / load balancer
# COOKIE_SECURE=true        # on by default in production (needs HTTPS)
# SESSION_TTL_HOURS=12
# REMEMBER_TTL_DAYS=30
